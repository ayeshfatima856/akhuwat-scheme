// ============================================================
// PRISMA SCHEMA - MySQL Version (Namecheap / PlanetScale)
// ============================================================
// Yeh schema MySQL database ke liye hai
// SQLite se MySQL par move kar rahe hain production ke liye
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev: SQLite | Production: MySQL (env mein change karein)
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// LOAN APPLICATIONS - Users ki loan forms
// ============================================================
model LoanApplication {
  id              String   @id @default(cuid())
  fullName        String
  fatherName      String
  cnicNumber      String
  phoneNumber     String
  email           String?
  ageAbove18      String
  gender          String
  maritalStatus   String
  city            String
  province        String
  bankAccount     String?
  loanType        String
  loanAmount      Float
  loanPurpose     String
  monthlyIncome   Float?
  
  // File URLs (Cloudinary se aayenge)
  cnicFrontUrl    String?
  cnicBackUrl     String?
  utilityBillUrl  String?
  
  // Tracking & Status
  trackingId      String   @unique  // User ko yeh milega track karne ke liye
  status          String   @default("Pending") // Pending | Approved | Rejected
  
  // User link (agar user login hai)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([trackingId])
}

// ============================================================
// ADMIN USERS - Admin panel login
// ============================================================
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String   // bcrypt hash
  role      String   @default("admin") // admin | super_admin
  createdAt DateTime @default(now())
}

// ============================================================
// REGULAR USERS - User login (application track karne ke liye)
// ============================================================
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  password     String   // bcrypt hash
  cnicNumber   String?  // optional
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // User ki applications
  applications LoanApplication[]

  @@index([email])
  @@index([phone])
}

// ============================================================
// CONTACT MESSAGES - Contact form messages
// ============================================================
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================
// EMAIL LOGS - Track bheji gayi emails
// ============================================================
model EmailLog {
  id         String   @id @default(cuid())
  toEmail    String
  subject    String
  body       String
  status     String   @default("sent") // sent | failed
  type       String   // application_submitted | status_update | etc
  createdAt  DateTime @default(now())

  @@index([toEmail])
}
