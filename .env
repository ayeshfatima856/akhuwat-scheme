# ============================================================
# ENVIRONMENT VARIABLES - Akhuwat Scheme
# ============================================================
# Yeh file local development ke liye hai
# Production mein Vercel/Namecheap par same variables set karein
# ============================================================

# Database (Local SQLite - development ke liye)
# Production mein MySQL use karein (Namecheap cPanel ya PlanetScale)
# MySQL Example: mysql://user:password@hostname:3306/database_name
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Production MySQL (Namecheap cPanel ke liye)
# Yahan apne Namecheap cPanel ka MySQL info daalein
# DATABASE_URL="mysql://akhuwat_user:YourPassword@localhost:3306/akhuwat_db"

# ============================================================
# EMAIL SETTINGS (Resend.com - Free 3000 emails/month)
# ============================================================
# Resend.com par free account banayein aur API key lein
# https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Jis email se notifications bhejne hain
FROM_EMAIL="noreply@akhuwatscheme.com"

# Jis email par notifications receive karne hain (admin)
ADMIN_EMAIL="admin@akhuwatscheme.com"

# ============================================================
# CLOUDINARY (File Uploads - Free tier 25GB)
# ============================================================
# Cloudinary.com par free account banayein
# https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ============================================================
# NEXTAUTH (User Login System)
# ============================================================
# Yeh ek secret key hai - koi bhi random string daal dein
# Production mein strong random string use karein
NEXTAUTH_SECRET="akhuwat-scheme-secret-key-change-this-in-production-2024"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# SITE URL (Production)
# ============================================================
# Vercel par deploy ke baad yeh update karein
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
